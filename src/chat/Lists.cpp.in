// Generated by the build from data/words.txt and data/emoji.txt: the lists
// are data, kept beside the code as files, and compiled in unchanged.
namespace chat {
const char* word_list_text() { return R"sgchatlist(@SGCHAT_WORDS@)sgchatlist"; }
const char* emoji_list_text() { return R"sgchatlist(@SGCHAT_EMOJI@)sgchatlist"; }
}  // namespace chat
namespace chat {
const char* conversation_template() { return R"sgchatlist(@SGCHAT_CONVERSATION@)sgchatlist"; }
const char* device_template() { return R"sgchatlist(@SGCHAT_DEVICE@)sgchatlist"; }
const char* call_template() { return R"sgchatlist(@SGCHAT_CALL@)sgchatlist"; }
const char* game_template() { return R"sgchatlist(@SGCHAT_GAME@)sgchatlist"; }
const char* board_template() { return R"sgchatlist(@SGCHAT_BOARD@)sgchatlist"; }
}  // namespace chat
